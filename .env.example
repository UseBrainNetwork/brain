# All variables are server-side only. Never prefix secrets with NEXT_PUBLIC_.

# --- Inference providers (optional) ---------------------------------------
# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Together, Groq, vLLM...).
BRAIN_EXTERNAL_BASE_URL=https://openrouter.ai/api/v1
BRAIN_EXTERNAL_API_KEY=
# Default model (AUTO and any mode without an override). Production runs open-weights, low-refusal
# models aimed at developers and crypto; BRAIN adds no filter layer of its own.
BRAIN_EXTERNAL_MODEL=deepseek/deepseek-v4-pro
# Optional per-mode overrides. Unset = BRAIN_EXTERNAL_MODEL.
BRAIN_EXTERNAL_MODEL_CHEAP=deepseek/deepseek-v4-flash
BRAIN_EXTERNAL_MODEL_FAST=
BRAIN_EXTERNAL_MODEL_QUALITY=nousresearch/hermes-4-405b

# Self-hosted cloud fallback (e.g. your own vLLM box). OpenAI-compatible.
BRAIN_FALLBACK_BASE_URL=
BRAIN_FALLBACK_API_KEY=
BRAIN_FALLBACK_MODEL=

# --- Public API keys -------------------------------------------------------
# Extra operator keys accepted on /v1/*. Self-serve keys are created at /account.
# /v1 always requires a key. BRAIN_OPEN_V1=1 opens it for a local demo only; never set in production.
BRAIN_API_KEYS=
BRAIN_OPEN_V1=

# --- Data layer ------------------------------------------------------------
# If set, the node/job store uses Postgres (see db/schema.sql). Otherwise in-memory.
DATABASE_URL=
# Optional: the same database through a second role (member of the first). Used when the shared
# pooler wedges the first role's pool; see services/pgStore.ts (lanes).
DATABASE_URL_ALT=

# --- Token (optional, enables real holdings lookup) -------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BRAIN_TOKEN_MINT=

# --- Paid plans (on-chain, no card) ----------------------------------------
# Paid plans are on by default: the buyer's wallet sends USDC or SOL to the payout wallet
# and the server verifies the transaction before activating. Set "off" to show plans as
# coming soon with no purchase path.
BRAIN_PAYMENTS=
# USDC mint override. Default: mainnet USDC, or devnet USDC when the cluster is devnet.
BRAIN_USDC_MINT=
# Holder access: a linked wallet holding at least this many BRAIN has the plan included
# while it holds (re-read from chain; never self-reported). Unset = not offered.
BRAIN_PLAN_PRO_HOLD_TOKENS=
BRAIN_PLAN_CODE_HOLD_TOKENS=
BRAIN_PLAN_MAX_HOLD_TOKENS=

# --- Rewards & payouts (server-only) ---------------------------------------
# Epoch length in minutes (default 1440 = daily, UTC-aligned).
BRAIN_EPOCH_MINUTES=
# SOL committed to the contributor pool per epoch. Without it (or poolSol on the
# settle call) epochs settle as SIMULATED and can never be claimed.
BRAIN_EPOCH_POOL_SOL=
# Share of plan purchases confirmed on chain during an epoch that is added to that epoch's pool
# (0..1). Default: inferenceRevenue.contributors from rewards/config.ts (0.6). 0 turns it off.
BRAIN_POOL_SALES_SHARE=
# Which plans send PUBLIC AUTO chat requests to community GPU nodes first (COMMUNITY mode):
# free (default) | all | off.
BRAIN_COMMUNITY_FIRST=
# Bearer token for POST /api/rewards/settle. CRON_SECRET is accepted too (Vercel Cron).
BRAIN_ADMIN_TOKEN=
CRON_SECRET=
# HMAC key for claim messages and wallet link tokens. Required on serverless/multi-instance
# deployments; any long random string (e.g. `openssl rand -hex 32`).
BRAIN_SERVER_SECRET=
# Ed25519 seed (32 bytes, base64) the coordinator signs compute receipts with. Unset = derived
# from BRAIN_SERVER_SECRET. Public key is served at /api/coordinator/signer.
BRAIN_COORDINATOR_SIGNING_SEED=

# Share of deterministic (temperature 0) node jobs re-run on a second node and compared (0..1, default 0.05).
# Mismatches lower both nodes' reliability scores. 0 disables.
BRAIN_VERIFY_SAMPLE_RATE=
# A production coordinator refuses mock-node registrations unless this is 1 (docker-compose sets it).
BRAIN_ALLOW_MOCK_NODES=

# --- Brain Node agent (node/, `npm run node`) — these are read by the agent, not the web app --------
# BRAIN_COORDINATOR_URL=https://brainnetwork.app   coordinator to join
# BRAIN_NODE_MODE=vllm|mock                        auto: vllm when nvidia-smi is present
# BRAIN_NODE_MODELS=qwen/qwen2.5-7b-instruct       comma-separated subset of node/models.ts (default: all that fit)
# BRAIN_NODE_REGION=eu-north                        operator label shown to developers
# BRAIN_NODE_CONCURRENCY=1                          parallel jobs, 1..16
# BRAIN_NODE_ASK_USD_PER_1M=                        optional ask price; a routing input
# BRAIN_NODE_WALLET=                                Solana address to associate
# BRAIN_NODE_HOME=~/.brain-node                     identity.json location
# HF_TOKEN=                                         for gated model repositories
# Inference relay (relay/, a Cloudflare Worker). URL of the deployed worker and the HMAC key shared
# with it (`wrangler secret put RELAY_SECRET`). Unset = NETWORK chat reports no capacity.
BRAIN_RELAY_URL=
BRAIN_RELAY_SECRET=
# Kill switch. Claims are refused unless this is exactly "true".
BRAIN_PAYOUTS_ENABLED=false
# Optional scheduled opening (ISO-8601 or epoch ms). Claims are refused before it and open automatically after.
# BRAIN_PAYOUTS_OPEN_AT=2026-10-05T16:00:00Z
# Epoch length in minutes (default 1440 = daily) and how many days the treasury's contributor share is paced over.
# BRAIN_EPOCH_MINUTES=60
# BRAIN_POOL_PACE_DAYS=1
# Payout wallet secret key: Solana CLI keypair JSON ([12,34,...]) or base58. Fund it with only
# what you intend to pay out. Never commit it; set it in the deployment's env settings.
BRAIN_PAYOUT_SECRET_KEY=
# Per-claim and rolling 24h payout limits, in SOL (defaults 5 and 50).
BRAIN_PAYOUT_MAX_SOL=
BRAIN_PAYOUT_DAILY_MAX_SOL=
# For explorer links: mainnet-beta | devnet | testnet
BRAIN_SOLANA_CLUSTER=mainnet-beta

# --- Realtime (optional, public) --------------------------------------------
# External websocket event bus. If unset, the app uses its built-in SSE stream.
NEXT_PUBLIC_BRAIN_WS_URL=

# --- Wallet login (optional, public) ------------------------------------------
# Privy app ID (public identifier). When set, "Connect wallet" opens Privy's Solana login
# (browser wallets or email → embedded Solana wallet). Ownership is still proven by a signed
# server nonce; Privy sessions are never trusted for rewards. Unset = built-in wallet picker.
# The Privy app SECRET is not used by this app; if you store it, keep it server-only and never NEXT_PUBLIC_.
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Phase 2: pricing, routing, customer API (server-only) --------------------
# List prices. Unset = receipts carry UNKNOWN cost and no accounting events are created.
# Never estimated or inferred.
BRAIN_PRICE_USD_PER_1K_COMPUTE_UNITS=
BRAIN_PRICE_USD_PER_1M_TOKENS=
# Payout emails (optional). Unset = no emails, nothing else changes. One email per wallet per settled
# epoch it was paid in, with one-click unsubscribe. The from-domain must be verified in Resend.
RESEND_API_KEY=
# BRAIN_EMAIL_FROM="BRAIN <rewards@brainnetwork.app>"
# Attached compute: every completed chat request dispatches a verification job to the browser network,
# sized by the request (see ECONOMICS.md). Set to "off" to disable. Default on.
# BRAIN_ATTACHED_COMPUTE=off
# What each upstream costs us per 1M tokens (used for protocol margin and routing cost).
BRAIN_FALLBACK_PRICE_USD_PER_1M=
BRAIN_EXTERNAL_PRICE_USD_PER_1M=
# Embedding model on the external provider; enables /v1/embeddings passthrough.
BRAIN_EXTERNAL_EMBED_MODEL=
# Optional. When set, POST /api/jobs and POST /api/orders from the console require this bearer.
BRAIN_DEMO_TOKEN=
# BRAIN_ADMIN_TOKEN (above) also protects POST /api/customers, POST /api/epochs, POST /api/treasury.

# Operator-scheduled baseline work: fleet-wide distributed jobs dispatched whenever none is in
# flight, so nodes have verifiable work between customer requests. Labeled on job and receipt; no
# customer charge; nodes paid from the hourly pool. "off" disables.
BRAIN_SCHEDULED_WORK=
BRAIN_SCHEDULED_WORK_PER_HOUR=40
BRAIN_SCHEDULED_WORK_GAP_MS=45000
