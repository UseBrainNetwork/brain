# All variables are server-side only. Never prefix secrets with NEXT_PUBLIC_.

# --- Inference providers (optional) ---------------------------------------
# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Together, Groq, vLLM...).
BRAIN_EXTERNAL_BASE_URL=https://api.openai.com/v1
BRAIN_EXTERNAL_API_KEY=
BRAIN_EXTERNAL_MODEL=gpt-4o-mini

# Self-hosted cloud fallback (e.g. your own vLLM box). OpenAI-compatible.
BRAIN_FALLBACK_BASE_URL=
BRAIN_FALLBACK_API_KEY=
BRAIN_FALLBACK_MODEL=

# --- Public API keys -------------------------------------------------------
# Extra operator keys accepted on /v1/*. Self-serve keys are created at /account.
# /v1 always requires a key. BRAIN_OPEN_V1=1 opens it for a local demo only; never set in production.
BRAIN_API_KEYS=
BRAIN_OPEN_V1=

# --- Data layer ------------------------------------------------------------
# If set, the node/job store uses Postgres (see db/schema.sql). Otherwise in-memory.
DATABASE_URL=

# --- Token (optional, enables real holdings lookup) -------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BRAIN_TOKEN_MINT=

# --- Rewards & payouts (server-only) ---------------------------------------
# Epoch length in minutes (default 1440 = daily, UTC-aligned).
BRAIN_EPOCH_MINUTES=
# SOL committed to the contributor pool per epoch. Without it (or poolSol on the
# settle call) epochs settle as SIMULATED and can never be claimed.
BRAIN_EPOCH_POOL_SOL=
# Bearer token for POST /api/rewards/settle. CRON_SECRET is accepted too (Vercel Cron).
BRAIN_ADMIN_TOKEN=
CRON_SECRET=
# HMAC key for claim messages and wallet link tokens. Required on serverless/multi-instance
# deployments; any long random string (e.g. `openssl rand -hex 32`).
BRAIN_SERVER_SECRET=
# Kill switch. Claims are refused unless this is exactly "true".
BRAIN_PAYOUTS_ENABLED=false
# Payout wallet secret key: Solana CLI keypair JSON ([12,34,...]) or base58. Fund it with only
# what you intend to pay out. Never commit it; set it in the deployment's env settings.
BRAIN_PAYOUT_SECRET_KEY=
# Per-claim and rolling 24h payout limits, in SOL (defaults 5 and 50).
BRAIN_PAYOUT_MAX_SOL=
BRAIN_PAYOUT_DAILY_MAX_SOL=
# For explorer links: mainnet-beta | devnet | testnet
BRAIN_SOLANA_CLUSTER=mainnet-beta

# --- Realtime (optional, public) --------------------------------------------
# External websocket event bus. If unset, the app uses its built-in SSE stream.
NEXT_PUBLIC_BRAIN_WS_URL=

# --- Phase 2: pricing, routing, customer API (server-only) --------------------
# List prices. Unset = receipts carry UNKNOWN cost and no accounting events are created.
# Never estimated or inferred.
BRAIN_PRICE_USD_PER_1K_COMPUTE_UNITS=
BRAIN_PRICE_USD_PER_1M_TOKENS=
# What each upstream costs us per 1M tokens (used for protocol margin and routing cost).
BRAIN_FALLBACK_PRICE_USD_PER_1M=
BRAIN_EXTERNAL_PRICE_USD_PER_1M=
# Embedding model on the external provider; enables /v1/embeddings passthrough.
BRAIN_EXTERNAL_EMBED_MODEL=
# Optional. When set, POST /api/jobs and POST /api/orders from the console require this bearer.
BRAIN_DEMO_TOKEN=
# BRAIN_ADMIN_TOKEN (above) also protects POST /api/customers, POST /api/epochs, POST /api/treasury.
